{
    "name": "frontend",
    "version": "0.1.0",
    "packageManager": "pnpm@11.17.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "next start",
        "start:build": "next start",
        "start:test": "pnpm build:test && pnpm start:build",
        "preinstall": "npx only-allow pnpm && pnpm touch-env && cd ../common && pnpm install",
        "touch-env": "touch .env.local .env.development.local .env.production.local .env.beta.local .env.test.local .env",
        "dev": "$npm_package_config_run_dev -- next dev",
        "precheck": "pnpm lint && next build && pnpm test:unit",
        "precheck:full": "pnpm precheck && pnpm test:playwright",
        "dev:precheck": "pnpm precheck && pnpm dev",
        "build": "pnpm build:production",
        "build:production": "$npm_package_config_run_prod -- next build",
        "build:beta": "$npm_package_config_run_beta -- next build",
        "build:test": "$npm_package_config_run_test -- next build",
        "build:development": "$npm_package_config_run_dev -- next build",
        "test": "pnpm test:unit && pnpm test:playwright",
        "test:unit": "$npm_package_config_run_test -- vitest run",
        "test:playwright": "playwright test --config=playwright/playwright.config.ts",
        "test:playwright:ui": "playwright test --config=playwright/playwright.config.ts --ui",
        "lint": "pnpm lint:types && eslint . --quiet",
        "lint:fix": "eslint --fix .",
        "lint:types": "tsc --noEmit",
        "lint:types:watch": "tsc --noEmit --watch",
        "format": "prettier src playwright --write",
        "format:check": "prettier src playwright --check",
        "docs": "pnpm docs:build && pnpm docs:serve",
        "docs:serve": "serve -l 8080 docs",
        "docs:build": "typedoc"
    },
    "config": {
        "run_dev": "dotenvx run --env-file=.env.development.local --env-file=.env.local --env-file=.env.development --env-file=.env",
        "run_test": "dotenvx run --env-file=.env.test.local --env-file=.env.local --env-file=.env.test --env-file=.env",
        "run_prod": "dotenvx run --env-file=.env.production.local --env-file=.env.local --env-file=.env.production --env-file=.env",
        "run_beta": "dotenvx run --env-file=.env.beta.local --env-file=.env.local --env-file=.env.beta --env-file=.env"
    },
    "browserslist": [
        ">0.2%",
        "not dead",
        "not op_mini all"
    ],
    "dependencies": {
        "@aws-amplify/adapter-nextjs": "^1.7.3",
        "@dotenvx/dotenvx": "^2.19.0",
        "@emotion/cache": "^11.13.5",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@formatjs/icu-messageformat-parser": "3.5.15",
        "@fortawesome/free-brands-svg-icons": "^6.7.2",
        "@fortawesome/free-solid-svg-icons": "^6.7.2",
        "@jackstenglein/chess": "^2.2.21",
        "@jackstenglein/chess-dojo-common": "file:../common",
        "@jackstenglein/pgn-parser": "^2.0.13",
        "@jackstenglein/react-scheduler": "^5.0.6",
        "@mui/icons-material": "^9.2.0",
        "@mui/lab": "^7.0.1-beta.25",
        "@mui/material": "^9.2.0",
        "@mui/material-nextjs": "^9.0.1",
        "@mui/x-charts": "^9.10.1",
        "@mui/x-data-grid-pro": "^9.10.1",
        "@mui/x-date-pickers-pro": "^9.3.0",
        "@mui/x-license": "^9.10.1",
        "@savi2w/chess-tcn": "^1.0.0",
        "@types/react": "^19.2.10",
        "@types/react-dom": "^19.2.3",
        "async-mutex": "^0.5.0",
        "aws-amplify": "^6.17.0",
        "axios": "^1.19.0",
        "bad-words": "^4.0.0",
        "chessground": "^9.2.1",
        "comlink": "^4.4.2",
        "copy-to-clipboard": "^3.3.3",
        "date-fns": "^4.1.0",
        "deep-equal": "^2.2.3",
        "idb": "^8.0.3",
        "lodash.debounce": "^4.0.8",
        "luxon": "^3.7.2",
        "modern-screenshot": "^4.6.8",
        "moment": "^2.30.1",
        "next": "^16.2.7",
        "next-intl": "^4.8.3",
        "next-navigation-guard": "^0.2.0",
        "react": "^19.2.4",
        "react-activity-calendar": "^2.7.14",
        "react-charts": "^3.0.0-beta.57",
        "react-countdown-circle-timer": "^3.2.1",
        "react-dom": "^19.2.7",
        "react-ga4": "^3.0.1",
        "react-google-button": "^0.8.0",
        "react-icons": "^5.6.0",
        "react-joyride": "^3.1.0",
        "react-markdown": "^10.1.0",
        "react-minimal-pie-chart": "^9.1.2",
        "react-resizable": "^4.0.2",
        "react-virtuoso": "^4.18.10",
        "remark-gfm": "^4.0.1",
        "rrule": "^2.8.1",
        "sharp": "^0.35.3",
        "use-long-press": "^3.3.0",
        "usehooks-ts": "^3.1.1",
        "uuid": "^13.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@istanbuljs/nyc-config-typescript": "^1.0.2",
        "@next/eslint-plugin-next": "^16.2.12",
        "@playwright/test": "^1.62.0",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/deep-equal": "^1.0.4",
        "@types/lodash.debounce": "^4.0.9",
        "@types/luxon": "^3.7.1",
        "@types/node": "^25.9.1",
        "@types/react-copy-to-clipboard": "^5.0.7",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-react": "^5.1.2",
        "command-line-args": "^6.0.2",
        "command-line-usage": "^7.0.4",
        "dotenv": "^17.4.2",
        "eslint": "^9.39.2",
        "eslint-config-next": "^16.2.12",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^17.8.0",
        "happy-dom": "^19.0.2",
        "jiti": "^2.7.0",
        "nyc": "^18.0.0",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "serve": "^14.2.5",
        "typedoc": "^0.28.19",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.54.0",
        "use-intl": "^4.13.4",
        "vite": "^7.1.9",
        "vitest": "^4.0.18",
        "zod-validation-error": "^5.0.0"
    },
    "overrides": {
        "d3-interpolate": "^3.0.1",
        "d3-color": "^3.1.0",
        "d3-scale": "^4.0.2",
        "next-navigation-guard": {
            "next": "^16.0.0"
        }
    }
}
